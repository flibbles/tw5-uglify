{
	"directories": [
		{
			"path": ".",
			"filesRegExp": "^.*\\.js$",
			"isTiddlerFile": true,
			"fields": {
				"tags": "$:/tags/test-spec",
				"type": "application/javascript",
				"title": {
					"source": "filename",
					"prefix": "Test/"
				}
			}
		},
		{
			"path": "./modules",
			"filesRegExp": "^.*\\.js$",
			"isTiddlerFile": true,
			"fields": {
				"type": "application/javascript",
				"title": {
					"source": "filename",
					"prefix": "Test/modules/"
				}
			}
		},
		{
			"path": "./wikitext",
			"filesRegExp": "^.*\\.js$",
			"isTiddlerFile": true,
			"fields": {
				"tags": "$:/tags/test-spec",
				"type": "application/javascript",
				"title": {
					"source": "filename",
					"prefix": "Test/wikitext/"
				}
			}
		},
		{
			"path": "./wikitext/html",
			"filesRegExp": "^.*\\.js$",
			"isTiddlerFile": true,
			"fields": {
				"tags": "$:/tags/test-spec",
				"type": "application/javascript",
				"title": {
					"source": "filename",
					"prefix": "Test/wikitext/html/"
				},
				"text": {
					"prefix": "describe('wikitext uglifier', function(){ describe('html', function() {",
					"suffix": "});});"
				}
			}
		}
	]
}
