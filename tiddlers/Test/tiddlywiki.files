{
	"directories": [
		{
			"path": ".",
			"filesRegExp": "^.*\\.js$",
			"isTiddlerFile": true,
			"fields": {
				"tags": "$:/tags/test-spec",
				"type": "application/javascript",
				"title": {
					"source": "filename",
					"prefix": "$:/test/"
				}
			}
		},
		{
			"path": "./modules",
			"filesRegExp": "^.*\\.js$",
			"isTiddlerFile": true,
			"fields": {
				"type": "application/javascript",
				"title": {
					"source": "filename",
					"prefix": "$:/test/modules/"
				}
			}
		},
		{
			"path": "./wikitext",
			"filesRegExp": "^.*\\.js$",
			"isTiddlerFile": true,
			"fields": {
				"tags": "$:/tags/test-spec",
				"type": "application/javascript",
				"title": {
					"source": "filename",
					"prefix": "$:/test/wikitext/"
				},
				"text": {
					"prefix": "describe('wikitext uglifier', function(){",
					"suffix": "});"
				}
			}
		},
		{
			"path": "./wikitext/html",
			"filesRegExp": "^.*\\.js$",
			"isTiddlerFile": true,
			"fields": {
				"tags": "$:/tags/test-spec",
				"type": "application/javascript",
				"title": {
					"source": "filename",
					"prefix": "$:/test/wikitext/html/"
				},
				"text": {
					"prefix": "describe('wikitext uglifier', function(){ describe('html', function() {",
					"suffix": "});});"
				}
			}
		}
	]
}
